// NyumbaKasarani — Prisma schema (Phase 1)
// Two-tier location model: Location (e.g. Kasarani TVC / Kamulu) -> SubLocation (e.g. Kamulu Town, Reflector Inn)

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  tenant
  landlord
  admin
}

enum PropertyCategory {
  single
  bedsitter
  one_bedroom
  two_bedroom
  shop
  office
}

enum ListingStatus {
  pending
  approved
  rejected
}

enum PaymentStatus {
  pending
  success
  failed
}

model User {
  id                   String         @id @default(cuid())
  name                 String
  email                String         @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?        // null if user signed up via Google only
  role                 Role           @default(tenant)
  loyaltyPaymentCount  Int            @default(0)
  createdAt            DateTime       @default(now())

  accounts             Account[]      // NextAuth: linked OAuth providers (e.g. Google)
  sessions             Session[]      // NextAuth: active login sessions
  resetTokens          PasswordResetToken[]

  properties           Property[]     @relation("LandlordProperties")
  comments             Comment[]
  ratings              Rating[]
  favorites            Favorite[]
  subscriptions        Subscription[]
  notifications        Notification[]
  suggestions          Suggestion[]
}

// ---- NextAuth required models ----
// These let NextAuth's PrismaAdapter manage OAuth linking (Google) and sessions
// alongside our own credentials-based (email/password) login.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- Custom: password reset flow (email/password accounts) ----
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model Location {
  id            String        @id @default(cuid())
  name          String        @unique // e.g. "Kasarani TVC (Kamulu)"
  subLocations  SubLocation[]
  createdAt     DateTime      @default(now())
}

model SubLocation {
  id          String     @id @default(cuid())
  name        String     // e.g. "Kamulu Town", "Reflector Inn", "Around School Gate"
  locationId  String
  location    Location   @relation(fields: [locationId], references: [id])
  properties  Property[]

  @@unique([locationId, name])
}

model Property {
  id               String            @id @default(cuid())
  landlordId       String
  landlord         User              @relation("LandlordProperties", fields: [landlordId], references: [id])
  title            String
  category         PropertyCategory
  subLocationId    String
  subLocation      SubLocation       @relation(fields: [subLocationId], references: [id])
  price            Int
  images           String[]          // Cloudinary URLs
  amenities        String[]          // e.g. "Security Guard", "Electricity (Tokens)", "Water inclusive of rent"

  // Gated fields — must be stripped server-side for users without an active subscription
  exactLocation    String?
  caretakerContact String?

  status           ListingStatus     @default(pending)
  featured         Boolean           @default(false)
  rented           Boolean           @default(false)
  pendingConfirmation Boolean        @default(false)
  claimedByUserId  String?
  createdAt        DateTime          @default(now())

  comments         Comment[]
  ratings          Rating[]
  favorites        Favorite[]
}

model Comment {
  id          String    @id @default(cuid())
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  body        String
  createdAt   DateTime  @default(now())
}

model Rating {
  id          String    @id @default(cuid())
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  stars       Int       // 1-5
  createdAt   DateTime  @default(now())

  @@unique([propertyId, userId]) // one rating per user per property
}

model Favorite {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id])
  createdAt   DateTime  @default(now())

  @@unique([userId, propertyId])
}

model Subscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  mpesaReceipt  String?
  amount        Int
  durationDays  Int
  isBonus       Boolean   @default(false) // true if granted via loyalty program
  startsAt      DateTime  @default(now())
  expiresAt     DateTime
}

model PaymentLog {
  id                  String        @id @default(cuid())
  checkoutRequestId   String        @unique // Daraja reference — used for idempotency
  userId              String?
  status              PaymentStatus @default(pending)
  rawCallbackPayload  Json?
  createdAt           DateTime      @default(now())
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  message     String
  read        Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

model Suggestion {
  id          String    @id @default(cuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  text        String
  imageUrl    String?
  createdAt   DateTime  @default(now())
}

model ContactSubmission {
  id          String    @id @default(cuid())
  fullName    String
  email       String
  phone       String?
  message     String
  createdAt   DateTime  @default(now())
}
